# Copy to .env and fill in values. Never commit .env.

# MongoDB (used by docker-compose and the API)
MONGO_URI=mongodb://mongo:27017
MONGO_DB=datalake

# Google Gemini — required for chat answers
GEMINI_API_KEY=

# Optional: NASA API key (demo works with DEMO_KEY; get a free key at https://api.nasa.gov)
NASA_API_KEY=DEMO_KEY

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
